# Copy this file to terraform.tfvars and fill in real values.
#   cp terraform.tfvars.example terraform.tfvars
#
# IMPORTANT: terraform.tfvars is gitignored. Do NOT commit real secrets.
# Secrets can instead be supplied via environment variables, e.g.:
#   export TF_VAR_render_api_key="rnd_xxx"
#   export TF_VAR_db_password="..."
#   export TF_VAR_rabbitmq_password="..."

# --- Provider auth (prefer env vars for these) ---
# render_api_key  = "rnd_xxxxxxxxxxxxxxxxxxxx"
render_owner_id = "tea-xxxxxxxxxxxxxxxxxxxx"

# --- Project / Environment (optional) ---
# Render groups services into Projects, each with one or more Environments
# (e.g. production, staging). Supply the Environment id to place the service
# under a project. Leave commented out to create it outside any project.
# render_environment_id = "evm-xxxxxxxxxxxxxxxxxxxx"


# --- Service basics ---
service_name = "event-consumer"
region       = "oregon"   # oregon | ohio | virginia | frankfurt | singapore
plan         = "starter"
docker_image = "bixoloo/event-consumer"
image_tag    = "latest"

# --- App ---
logging_level = "INFO"
db_mode       = "never"

# --- Database ---
db_url      = "jdbc:mysql://your-db-host:3306/sportsbook?useSSL=true&serverTimezone=UTC"
db_username = "appuser"
# db_password = "..."   # prefer TF_VAR_db_password
db_name     = "sportsbook"

# --- RabbitMQ ---
rabbitmq_host     = "your-rabbitmq-host"
rabbitmq_port     = "5672"
rabbitmq_username = "appuser"
# rabbitmq_password = "..."   # prefer TF_VAR_rabbitmq_password
rabbitmq_vhost    = "/"

# --- RabbitMQ topology (override only if you don't want the defaults) ---
# rabbitmq_matches = {
#   exchange    = "matches.exchange"
#   queue       = "matches.queue"
#   routing_key = "matches.routing.key"
# }
