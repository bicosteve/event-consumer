# Terraform state & local artifacts — never commit these.
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Real variable files may contain secrets. Keep only the example.
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# CLI override & plan files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfplan

# Lock file is intentionally committed (.terraform.lock.hcl) for reproducible providers.
