# Keep the build context small and prevent secrets/local artifacts from
# ever being copied into the image.

# Secrets & local env
.env
.env.*
!.env-example

# Build output (the image builds its own jar inside the builder stage)
target/
build/

# Logs
logs/

# Version control & CI
.git/
.github/

# IDE / OS noise
.idea/
*.iml
*.iws
*.ipr
.vscode/
.DS_Store

# Docs & misc
HELP.md
README.md
notes.txt
