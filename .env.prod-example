DOCKER_IMAGE=bixoloo/event-consumer
IMAGE_TAG=latest

# --- App / server ----------------------------------
APP_PORT=5003
LOGGING_LEVEL=INFO

DB_URL=jdbc:mysql://CHANGE_ME.aivencloud.com:PORT/defaultdb?sslMode=REQUIRED&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_PORT=PORT
DB_NAME=defaultdb
DB_MODE=never

RABBITMQ_HOST=CHANGE_ME
RABBITMQ_PORT=5671
RABBITMQ_USERNAME=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=/
RABBITMQ_SSL_ENABLED=true

# --- RabbitMQ: matches ---
RABBITMQ_MATCHES_EXCHANGE=matches.exchange
RABBITMQ_MATCHES_QUEUE=matches.queue
RABBITMQ_MATCHES_ROUTING_KEY=matches.routing.key

# --- RabbitMQ: results ---
RABBITMQ_RESULTS_EXCHANGE=results.exchange
RABBITMQ_RESULTS_QUEUE=results.queue
RABBITMQ_RESULTS_ROUTING_KEY=results.routing.key

# --- RabbitMQ: transactions ---
RABBITMQ_TRANSACTIONS_EXCHANGE=transactions.exchange
RABBITMQ_TRANSACTIONS_QUEUE=transactions.queue
RABBITMQ_TRANSACTIONS_ROUTING_KEY=transactions.routing.key

# --- RabbitMQ: wallets ---
RABBITMQ_WALLETS_EXCHANGE=wallets.exchange
RABBITMQ_WALLETS_QUEUE=wallets.queue
RABBITMQ_WALLETS_ROUTING_KEY=wallets.routing.key

# --- Grafana Alloy -> Loki (logging sidecar) ---------------
ENVIRONMENT=production
LOKI_URL=https://logs-prod-xxx.grafana.net/loki/api/v1/push
LOKI_USERNAME=CHANGE_ME
LOKI_PASSWORD=CHANGE_ME
