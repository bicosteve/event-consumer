APP_PORT=5003
LOGGING_LEVEL=DEBUG

# Required: kafka or rabbitmq
MESSAGING_BROKER=rabbitmq

# Host processes use the Compose external listener; the Compose app overrides this to kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_MATCHES_TOPIC=matches.queue
KAFKA_RESULTS_TOPIC=results.queue
KAFKA_TRANSACTIONS_TOPIC=transactions.queue
KAFKA_MATCHES_GROUP=event-consumer-matches
KAFKA_RESULTS_GROUP=event-consumer-results
KAFKA_TRANSACTIONS_GROUP=event-consumer-transactions

# Local development only. Production should set false; topics are provisioned externally.
KAFKA_CREATE_TOPICS=true

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# Set true for TLS endpoints (normally port 5671).
RABBITMQ_SSL_ENABLED=false
# Synchronous publish-confirm/return timeout in milliseconds.
RABBITMQ_PUBLISHER_TIMEOUT_MILLIS=10000

RABBITMQ_MATCHES_EXCHANGE=matches.exchange
RABBITMQ_MATCHES_QUEUE=matches.queue
RABBITMQ_MATCHES_ROUTING_KEY=matches.routing.key
RABBITMQ_MATCHES_DLX=event-consumer.matches.dlx
RABBITMQ_MATCHES_DLK=event-consumer.matches.dlq
RABBITMQ_MATCHES_DLQ=event-consumer.matches.dlq

RABBITMQ_RESULTS_EXCHANGE=results.exchange
RABBITMQ_RESULTS_QUEUE=results.queue
RABBITMQ_RESULTS_ROUTING_KEY=results.routing.key
RABBITMQ_RESULTS_DLX=event-consumer.results.dlx
RABBITMQ_RESULTS_DLK=event-consumer.results.dlq
RABBITMQ_RESULTS_DLQ=event-consumer.results.dlq

RABBITMQ_TRANSACTIONS_EXCHANGE=transactions.exchange
RABBITMQ_TRANSACTIONS_QUEUE=transactions.queue
RABBITMQ_TRANSACTIONS_ROUTING_KEY=transactions.routing.key
RABBITMQ_TRANSACTIONS_DLX=event-consumer.transactions.dlx
RABBITMQ_TRANSACTIONS_DLK=event-consumer.transactions.dlq
RABBITMQ_TRANSACTIONS_DLQ=event-consumer.transactions.dlq

RABBITMQ_WALLETS_EXCHANGE=wallets.exchange
RABBITMQ_WALLETS_QUEUE=wallets.queue
RABBITMQ_WALLETS_ROUTING_KEY=wallets.routing.key

H2DB=jdbc:h2:mem:testdb;MODE=MySQL;DATABASE_TO_LOWER=TRUE

DB_URL=jdbc:mysql://localhost:3306/sportsbook?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=
DB_PASSWORD=
DB_NAME=sportsbook
DB_MODE=never

# Redis read-model cache (independent of MESSAGING_BROKER)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
EVENT_CACHE_RECONCILE_INTERVAL=PT5M
EVENT_CACHE_RECONCILE_BATCH_SIZE=100
EVENT_CACHE_RECONCILE_LOCK_TTL=PT4M